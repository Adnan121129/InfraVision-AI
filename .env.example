# =============================================================================
# InfraVision AI configuration. Copy to `.env` and replace every "change-me".
# Never commit a real .env file.
# =============================================================================

# ---- Django core -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
# Local Docker serves plain HTTP. Set both to true in production behind HTTPS.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_HSTS_SECONDS=2592000
LOG_LEVEL=INFO

# ---- Authentication ----------------------------------------------------------
# Optional dedicated JWT signing key (defaults to DJANGO_SECRET_KEY).
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
ALLOW_SELF_REGISTRATION=true

# ---- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=infravision
POSTGRES_USER=infravision
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL overrides the POSTGRES_* values when set.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ---- Redis (Celery broker, results, cache, Channels) -------------------------
REDIS_URL=redis://redis:6379/0

# ---- Object storage (MinIO locally, AWS S3 in production) ---------------------
USE_S3=true
AWS_STORAGE_BUCKET_NAME=infravision-inspections
AWS_S3_ENDPOINT_URL=http://minio:9000
# Endpoint the *browser* uses for presigned image URLs (unset for AWS S3).
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_QUERYSTRING_EXPIRE=3600
# Application credentials (a least-privilege MinIO user is created by minio-init).
AWS_ACCESS_KEY_ID=infravision-app
AWS_SECRET_ACCESS_KEY=change-me-app-storage-secret
# MinIO root account (local development only).
MINIO_ROOT_USER=infravision-admin
MINIO_ROOT_PASSWORD=change-me-minio-root-password
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z

# ---- Upload limits -----------------------------------------------------------
MAX_IMAGE_UPLOAD_MB=25
MAX_IMAGES_PER_INSPECTION=20
MAX_IMAGE_PIXELS=80000000

# ---- ML worker -----------------------------------------------------------------
# demo    = clearly-labelled heuristic OpenCV detector (no trained weights needed)
# pytorch = trained checkpoint: $MODEL_DIR/model.pt + $MODEL_DIR/model_card.json
INFERENCE_MODE=demo
MODEL_DIR=/models
MODEL_DEVICE=auto
MODEL_BATCH_SIZE=32
DETECTION_THRESHOLD=0.55
WORKING_MAX_SIDE=2048
# Only if explicitly enabled does a failed production model fall back to demo inference.
INFERENCE_ALLOW_DEMO_FALLBACK=false
# Build the ml-worker image without PyTorch (demo mode only, much smaller image).
INSTALL_PYTORCH=true
INFERENCE_SOFT_TIME_LIMIT=600
INFERENCE_STALL_MINUTES=30

# ---- Demo data ---------------------------------------------------------------
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=InfraVision@2026

# ---- Frontend (nginx) ----------------------------------------------------------
# Origin allowed to serve images in the Content-Security-Policy (MinIO / S3 / CDN).
PUBLIC_STORAGE_ORIGIN=http://localhost:9000
